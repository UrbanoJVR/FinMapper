<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.urbanojvr</groupId>
        <artifactId>finmapper</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>finmapper-desktop</artifactId>
    <name>finmapper-desktop</name>
    <description>JavaFX desktop shell (WebView) for Finmapper</description>

    <dependencies>
        <dependency>
            <groupId>com.urbanojvr</groupId>
            <artifactId>finmapper-app</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
        </dependency>
    </dependencies>

    <!-- finmapper-app es jar de librería transitiva (.jar normal); todas las libs Spring vienen transitivamente -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.urbanojvr.finmapper.desktop.DesktopLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- make mac-app  (o: ./mvnw -pl finmapper-desktop -am -Pmac-app package) -->
    <profiles>
        <profile>
            <id>mac-app</id>
            <properties>
                <jpackage.dest>${project.build.directory}/dist</jpackage.dest>
                <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-deps</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <stripVersion>false</stripVersion>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-copy-main-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <name>Finmapper</name>
                                    <appVersion>1.0.0</appVersion>
                                    <vendor>${project.groupId}</vendor>
                                    <destination>${jpackage.dest}</destination>
                                    <input>${jpackage.input}</input>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>com.urbanojvr.finmapper.desktop.DesktopLauncher</mainClass>
                                    <type>APP_IMAGE</type>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
